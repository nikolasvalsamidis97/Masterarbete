  author = {Swain, Mark R. and Estrela, Raissa and Roudier, Gael M. and Sotin, Christophe and Rimmer, Paul B. and Valio, Adriana and West, Robert and Pearson, Kyle and Huber-Feely, Noah and Zellem, Robert T.},
