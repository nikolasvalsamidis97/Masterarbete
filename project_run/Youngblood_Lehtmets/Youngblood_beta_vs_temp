def scalar_value(x):
  if isinstance(x, u.Quantity):
    return float(np.squeeze(x.value))
  return float(np.squeeze(x))


def make_molecule(species, config, wav_min, wav_max):
  molecule = Molecule(species, wav_min, wav_max)
  source = config["source"].lower()
  fetch_kwargs = config["fetch_kwargs"]

  if source == "exomol":
    molecule.fetch_exomol(**fetch_kwargs)
  elif source == "hitran":
    molecule.fetch_hitran(**fetch_kwargs)
  else:
    raise ValueError(f"Unknown molecule source: {config['source']}")

  return molecule


atoms = {species: Atom(species, wavemin, wavemax) for species in atom_species}
broad = {species: BroadeningProfile(atom, b, Npts, 'Voigt') for species, atom in atoms.items()}

molecules = {
  species: make_molecule(species, config, wavemin, wavemax)
  for species, config in molecule_configs.items()
}
broad_mol = {
  species: BroadeningProfileMolecule(molecule, b, profileType='Voigt')
  for species, molecule in molecules.items()
}
broad_mol["CO"].temp_strength_rel_cutoff = 0

stars = {
  name: Star(
    model["path"],
    model["radius"],
    model["mass"],
    vsini=model["vsini"],
    epsilon=model["epsilon"],
  )
  for name, model in stellar_models.items()
}

plot_species = atom_species + list(molecule_configs.keys())

teff_vals = []
beta_results = {species: [] for species in plot_species}
beta_err_results = {species: [] for species in plot_species}

selected_teff_values = {8000, 9000, 10000, 11000, 12000, 13000}
distance = 0.1 * u.au  

for star_name, model in stellar_models.items():
  star = stars[star_name]
  Teff = model["Teff"]
  Teff_val = int(round(Teff.to_value(u.K)))

  if Teff_val not in selected_teff_values:
    continue

  teff_vals.append(Teff.to_value(u.K))
  print(f"Calculating beta for {star_name} at T_eff = {Teff}")

  for species in atom_species:
    pp = PhotonPressure(broad[species], star)
    F_ph_tot, F_ph_tot_err, _, _ = pp.calc_PhotonPressure(Ncol, Teff, distance)
    beta, beta_err = pp.beta_Values(F_ph_tot, F_ph_tot_err, star.mass, distance)
    beta_results[species].append(scalar_value(beta))
    beta_err_results[species].append(scalar_value(beta_err))

  for species in molecule_configs.keys():
    pp = PhotonPressure(broad_mol[species], star)
    F_ph_tot, F_ph_tot_err, _, _ = pp.calc_PhotonPressure(Ncol, T_mol, distance)
    beta, beta_err = pp.beta_Values(F_ph_tot, F_ph_tot_err, star.mass, distance)
    beta_results[species].append(scalar_value(beta))
    beta_err_results[species].append(scalar_value(beta_err))

plt.figure(figsize=(10, 6))
for species in plot_species:
  plt.plot(teff_vals, beta_results[species], marker='o', label=species)

plt.yscale('log')
plt.xlabel(r"$T_{\mathrm{eff}}$ (K)")
plt.ylabel(r"$\beta$")
plt.title(r"$\beta$ vs $T_{\mathrm{eff}}$")
plt.grid(True, which='both', alpha=0.3)
plt.legend()
plt.tight_layout()
plt.show()

weights = broad_mol["CO"].boltzmann_line_weights(T_mol)
sig0 = np.abs(broad_mol["CO"].sig_0[:, 0].to_value(u.cm**2 * u.km / u.s))
strength = weights * sig0
idx = np.argsort(strength)[-20:][::-1]

print("Top 20 CO weighted lines:")
for i in idx:
